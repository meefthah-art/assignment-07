# Better Auth
BETTER_AUTH_SECRET=put-a-random-string-here-32-characters-or-more
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL (Neon / Supabase / local)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# API (optional, default is already set in code)
NEXT_PUBLIC_API_URL=https://api.abcz.workers.dev/api/bazardor
